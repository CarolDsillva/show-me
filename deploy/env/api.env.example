# Installed on the VM as /etc/reprofix/api.env, owner root:rfapi, mode 0640.
# sandboxd never receives this file.

VULTR_INFERENCE_API_KEY=

# Fine-grained token limited to our fork: issues, pull requests and contents.
GITHUB_TOKEN=

# Fixed target. No request can change this.
TARGET_REPO=

# Needed to approve or reject a patch in the public demo.
OPERATOR_PASSCODE=

# Set to false to ship the ReproBot fallback.
FIX_PHASE_ENABLED=true
